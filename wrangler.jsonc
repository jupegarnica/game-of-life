{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "game-of-life",
  "compatibility_date": "2026-10-15",
  "routes": [
    {
      "pattern": "game-of-life.garn.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  }
}
